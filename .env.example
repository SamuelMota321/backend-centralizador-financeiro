NODE_ENV=development
PORT=3000

# Auth0 API validation. Use the tenant issuer URL and the API Identifier configured in Auth0.
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://api.centralizador-financeiro.local

# Private Cloudflare R2 bucket for temporary OFX source files.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=private-ofx-imports
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me

# Runtime uses the least-privileged application role. In Neon, use the pooled -pooler endpoint.
DATABASE_URL=postgresql://cfi_runtime:replace_me@localhost:5432/cfi?schema=public

# Prisma Migrate uses a direct connection and the dedicated migration role.
DIRECT_DATABASE_URL=postgresql://cfi_migrator:replace_me@localhost:5432/cfi?schema=public

# Isolated integration-test role/database only.
TEST_DATABASE_URL=postgresql://cfi_test:replace_me@localhost:5432/cfi?schema=public

# Local PostgreSQL bootstrap values. Never reuse these examples outside local development.
POSTGRES_DB=cfi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_me
CFI_MIGRATOR_PASSWORD=replace_me
CFI_RUNTIME_PASSWORD=replace_me
CFI_TEST_PASSWORD=replace_me

# Pluggy credentials and webhook configuration. Configure these separate
# client-level events through Pluggy's API with X-Pluggy-Webhook-Secret set to
# the same secret: item/created, item/updated, item/deleted, item/error,
# item/waiting_user_input, item/waiting_user_action, and item/login_succeeded.
PLUGGY_CLIENT_ID=replace_me
PLUGGY_CLIENT_SECRET=replace_me
PLUGGY_WEBHOOK_SECRET=replace_with_at_least_32_characters
PLUGGY_WEBHOOK_URL=https://api.example.com/api/v1/webhooks/pluggy

# QStash durable webhook processing. Keep signing keys and tokens in the secret manager.
PUBLIC_API_BASE_URL=https://api.example.com
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=replace_me
QSTASH_CURRENT_SIGNING_KEY=replace_me
QSTASH_NEXT_SIGNING_KEY=replace_me
