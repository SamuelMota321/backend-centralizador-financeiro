generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentityProvider {
  AUTH0 @map("auth0")

  @@map("identity_provider")
}

enum AccountOrigin {
  MANUAL    @map("manual")
  CONNECTED @map("connected")

  @@map("account_origin")
}

enum AccountExternalProvider {
  PLUGGY @map("pluggy")

  @@map("account_external_provider")
}

enum AccountType {
  CHECKING    @map("checking")
  SAVINGS     @map("savings")
  PAYMENT     @map("payment")
  CASH        @map("cash")
  CREDIT_CARD @map("credit_card")
  INVESTMENT  @map("investment")
  OTHER       @map("other")

  @@map("account_type")
}

enum TransactionType {
  INCOME   @map("income")
  EXPENSE  @map("expense")
  TRANSFER @map("transfer")

  @@map("transaction_type")
}

enum TransactionStatus {
  POSTED @map("posted")
  VOIDED @map("voided")

  @@map("transaction_status")
}

enum TransferSide {
  OUTGOING @map("outgoing")
  INCOMING @map("incoming")

  @@map("transfer_side")
}

enum CategorizationStatus {
  UNCLASSIFIED  @map("unclassified")
  CATEGORIZED   @map("categorized")
  UNCERTAIN     @map("uncertain")
  UNRECOGNIZED  @map("unrecognized")
  NOT_APPLICABLE @map("not_applicable")

  @@map("categorization_status")
}

enum CategorizationSource {
  MANUAL @map("manual")
  RULE   @map("rule")

  @@map("categorization_source")
}

enum CategorySource {
  USER @map("user")

  @@map("category_source")
}

enum CategoryStatus {
  ACTIVE   @map("active")
  ARCHIVED @map("archived")

  @@map("category_status")
}

enum CategoryRuleStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  REMOVED  @map("removed")

  @@map("category_rule_status")
}

enum CategoryRuleConditionField {
  DESCRIPTION @map("description")
  TYPE        @map("type")
  ACCOUNT_ID  @map("account_id")

  @@map("category_rule_condition_field")
}

enum CategoryRuleOperator {
  EQUALS      @map("equals")
  CONTAINS    @map("contains")
  STARTS_WITH @map("starts_with")
  ENDS_WITH   @map("ends_with")

  @@map("category_rule_operator")
}

enum IdempotencyStatus {
  PENDING   @map("pending")
  COMPLETED @map("completed")

  @@map("idempotency_status")
}

enum AuditAction {
  ACCOUNT_UPDATED     @map("account_updated")
  ACCOUNT_DEACTIVATED @map("account_deactivated")

  @@map("audit_action")
}

enum AuditResourceType {
  ACCOUNT @map("account")

  @@map("audit_resource_type")
}

enum AuditOutcome {
  SUCCESS @map("success")

  @@map("audit_outcome")
}

model Tenant {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user         User?
  accounts     Account[]
  transactions Transaction[]
  categories   Category[]
  categoryRules CategoryRule[]
  auditRecords AuditRecord[]
  idempotencyKeys IdempotencyKey[]

  @@map("tenants")
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @unique(map: "users_tenant_id_key") @map("tenant_id") @db.Uuid
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "users_tenant_id_fkey")
  identityLinks IdentityLink[]
  auditRecords  AuditRecord[]  @relation("AuditActor")

  @@map("users")
}

model IdentityLink {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  provider  IdentityProvider
  issuer    String           @db.VarChar(255)
  subject   String           @db.VarChar(255)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "identity_links_user_id_fkey")

  @@unique([issuer, subject], map: "identity_links_issuer_subject_key")
  @@index([userId], map: "identity_links_user_id_idx")
  @@map("identity_links")
}

model Account {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  name               String                   @db.VarChar(100)
  type               AccountType
  origin             AccountOrigin            @default(MANUAL)
  institutionName    String?                  @map("institution_name") @db.VarChar(120)
  initialBalance     Decimal                  @map("initial_balance") @db.Decimal(19, 2)
  initialBalanceAsOf DateTime                 @map("initial_balance_as_of") @db.Date
  currencyCode       String                   @default("BRL") @map("currency_code") @db.VarChar(3)
  externalProvider   AccountExternalProvider? @map("external_provider")
  externalAccountId  String?                  @map("external_account_id") @db.VarChar(255)
  archivedAt         DateTime?                @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "accounts_tenant_id_fkey")
  transactions       Transaction[]
  auditRecords       AuditRecord[]

  @@unique([tenantId, externalProvider, externalAccountId], map: "accounts_external_identity_key")
  @@index([tenantId, archivedAt], map: "accounts_tenant_id_archived_at_idx")
  @@index([tenantId, type], map: "accounts_tenant_id_type_idx")
  @@map("accounts")
}

model Transaction {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  accountId            String              @map("account_id") @db.Uuid
  type                 TransactionType
  amount               Decimal             @db.Decimal(19, 2)
  occurredOn           DateTime            @map("occurred_on") @db.Date
  description          String?             @db.Text
  status               TransactionStatus   @default(POSTED)
  transferId           String?             @map("transfer_id") @db.Uuid
  transferSide         TransferSide?       @map("transfer_side")
  categoryId           String?             @map("category_id") @db.Uuid
  categorizationStatus CategorizationStatus @default(UNCLASSIFIED) @map("categorization_status")
  categorizationSource CategorizationSource? @map("categorization_source")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_tenant_id_fkey")
  account              Account             @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_account_id_fkey")
  category             Category?           @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "transactions_category_id_fkey")

  @@index([tenantId, occurredOn, id], map: "transactions_tenant_occurred_on_id_idx")
  @@index([tenantId, accountId, occurredOn, id], map: "transactions_tenant_account_occurred_on_id_idx")
  @@index([tenantId, transferId], map: "transactions_tenant_transfer_id_idx")
  @@index([tenantId, categoryId], map: "transactions_tenant_category_id_idx")
  @@map("transactions")
}

model IdempotencyKey {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  operation    String           @db.VarChar(100)
  key          String           @db.VarChar(255)
  payloadHash  String           @map("payload_hash") @db.Char(64)
  status       IdempotencyStatus @default(PENDING)
  resourceIds  Json             @default("[]") @map("resource_ids")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(3)
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "idempotency_keys_tenant_id_fkey")

  @@unique([tenantId, operation, key], map: "idempotency_keys_tenant_operation_key_key")
  @@index([tenantId, expiresAt], map: "idempotency_keys_tenant_expires_at_idx")
  @@map("idempotency_keys")
}

model Category {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  name         String        @db.VarChar(100)
  source       CategorySource @default(USER)
  status       CategoryStatus @default(ACTIVE)
  archivedAt   DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "categories_tenant_id_fkey")
  transactions Transaction[]
  rules        CategoryRule[]

  @@unique([tenantId, name], map: "categories_tenant_name_key")
  @@index([tenantId, status, name], map: "categories_tenant_status_name_idx")
  @@map("categories")
}

model CategoryRule {
  id                 String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                    @map("tenant_id") @db.Uuid
  categoryId         String                    @map("category_id") @db.Uuid
  conditionField     CategoryRuleConditionField @map("condition_field")
  conditionOperator  CategoryRuleOperator      @map("condition_operator")
  conditionValue    String                    @map("condition_value") @db.Text
  priority           Int                       @default(0)
  status             CategoryRuleStatus        @default(ACTIVE)
  removedAt          DateTime?                 @map("removed_at") @db.Timestamptz(3)
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "category_rules_tenant_id_fkey")
  category           Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "category_rules_category_id_fkey")

  @@index([tenantId, status, priority, createdAt, id], map: "category_rules_tenant_status_priority_created_at_id_idx")
  @@index([tenantId, categoryId, status], map: "category_rules_tenant_category_status_idx")
  @@map("category_rules")
}

model AuditRecord {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  actorUserId  String            @map("actor_user_id") @db.Uuid
  action       AuditAction
  resourceType AuditResourceType @map("resource_type")
  resourceId   String            @map("resource_id") @db.Uuid
  outcome      AuditOutcome
  requestId    String            @map("request_id") @db.Uuid
  metadata     Json              @default("{}")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_records_tenant_id_fkey")
  actorUser    User              @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_records_actor_user_id_fkey")
  resource     Account           @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_records_resource_id_fkey")

  @@index([tenantId, createdAt, id], map: "audit_records_tenant_created_at_id_idx")
  @@index([tenantId, resourceId, createdAt], map: "audit_records_tenant_resource_created_at_idx")
  @@index([requestId], map: "audit_records_request_id_idx")
  @@map("audit_records")
}
